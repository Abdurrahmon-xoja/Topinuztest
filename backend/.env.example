# Copy to backend/.env and fill in. backend/.env is gitignored.
#
# Note: dotenv resolves .env from the current working directory, so start the
# server from the backend/ directory for this file to be picked up:
#   cd backend && node server.js
# Running `npm start` from the repo root does not load it; every value below
# then falls back to its default, which is fine for a quick local look but
# leaves JWT_SECRET on a well-known literal.

# Port the Express server listens on. Default: 3000
PORT=3000

# Signing key for JWTs. Required in any deployed environment.
# Without it, middlewares/authMiddleware.js falls back to a hardcoded literal,
# which means anyone can mint valid tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Postgres connection string. Leave unset for local development: config/database.js
# then uses a SQLite file at backend/database.sqlite instead.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Cloudinary credentials for image and model uploads. Leave all three unset for
# local development: utils/uploader.js then writes to frontend/uploads/ on disk.
# All three must be present for Cloudinary to be used.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
